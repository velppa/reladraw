// `shape: octagon`. An octagon is a gate the flow must pass - a stop sign. It
// is the box its text needs with each corner cut square across, widened so
// the text stays clear of the cuts.

style gate      shape: octagon  border: theme-secondary
style terminal  shape: pill     border: theme-primary

node start  "start"                                        style: terminal
node draft  "draft the reply"                              below start
node verify "verify / every post, both modes"              below draft  style: gate
node post   "post"                                         below verify (gap: wide)
node hold   "hold the reply / until a human / has looked"  right of verify (gap: wide)  level with verify  style: gate
node done   "done"                                         below post  style: terminal

edge start -> draft
edge draft -> verify
edge verify -> post "pass"
edge verify -> hold "fail"  from: right  to: left
edge post -> done
edge hold -> done  from: bottom  to: right  line: (path: square)

// Several edges on one side spread along it, and one landing beside a cut
// corner meets the cut rather than the corner of the box around it.
node a "a"  right of hold (gap: wide)  above hold
node b "b"  below a (gap: wide)
node c "c"  below b (gap: wide)
edge a -> hold  from: left  to: right
edge b -> hold  from: left  to: right
edge c -> hold  from: left  to: right

// An edge naming no side meets the octagon where the line to the far end
// crosses it, and a corner of an octagon is the middle of its cut.
edge c -> verify
node dot ""  on verify top-right  shape: circle
node dot2 ""  on hold bottom-left  shape: circle
